profile todoist-reclaim-webhook flags=(attach_disconnected,mediate_deleted,complain) {
  include <abstractions/base>

  # Container baseline (mirrors docker-default's hardening)
  deny @{PROC}/* w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/k[^e]** w,
  deny @{PROC}/sys/ke[^r]** w,
  deny @{PROC}/sys/ker[^n]** w,
  deny @{PROC}/sys/kern[^e]** w,
  deny @{PROC}/sys/kerne[^l]** w,
  deny @{PROC}/sys/kernel/{,**} wklx,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/firmware/{,**} rwklx,
  deny mount,

  # signals
  signal (receive) set=(kill) peer=runc,
  signal (receive) set=(term) peer=runc,

  # files
  "/usr/local/lib/libpython3.13.so.1.0" mr,
  "/usr/local/lib/python3.13/" r,
}
